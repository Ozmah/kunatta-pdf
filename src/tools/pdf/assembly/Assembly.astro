---
import { routeLocale, translator } from "../../../i18n/translate.ts";

const lang = routeLocale(Astro.currentLocale);
const t = translator(lang);
---

<section class="assembly" hidden data-assembly aria-labelledby="assembly-title">
	<header class="head">
		<h2 class="display" id="assembly-title" tabindex="-1">
			{t("assembly.title")} <span class="count" data-count></span>
		</h2>
		<span class="hint">{t("assembly.hint")}</span>
	</header>

	<div class="stack" data-stack>
		<ol class="list" data-list></ol>
		<div class="slot" hidden data-slot></div>
	</div>
	<div class="sr-only" aria-live="polite" data-announce></div>

	<button class="add" type="button" data-dropzone data-add>
		<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M4 12h16"></path></svg>
		{t("assembly.add")}
	</button>

	<div class="notice notice-accent done" role="status" hidden data-assembly-done>
		<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12l5 5L20 6"></path></svg>
		<span data-done-text></span>
		<button class="btn-ghost" type="button" data-assembly-again>{t("fast.again")}</button>
	</div>

	<div class="progress" hidden data-progress>
		<div class="track" role="progressbar" aria-valuemin="0" aria-valuemax="100" data-progress-bar>
			<span data-progress-fill></span>
		</div>
		<div class="progress-text"><span data-progress-label></span><span data-progress-percent></span></div>
	</div>

	<div class="bar">
		<label class="name field-group">
			<span class="label">{t("assembly.name")}</span>
			<span class="field">
				<input type="text" maxlength="200" spellcheck="false" autocomplete="off" data-pdf-name />
				<span class="field-suffix" aria-hidden="true">.pdf</span>
			</span>
		</label>
		<button class="btn btn-primary" type="button" data-make>{t("assembly.make")}</button>
		<button class="btn-ghost" type="button" hidden data-cancel>{t("assembly.cancel")}</button>
	</div>
</section>

<template data-row-template>
	<li class="row">
		<span class="pinmark" hidden></span>
		<span class="mtag" hidden></span>
		<span class="ix"></span>
		<button class="grip" type="button" data-handle data-grip>
			<svg width="12" height="18" viewBox="0 0 12 18" aria-hidden="true"><circle cx="3" cy="3" r="1.6"></circle><circle cx="9" cy="3" r="1.6"></circle><circle cx="3" cy="9" r="1.6"></circle><circle cx="9" cy="9" r="1.6"></circle><circle cx="3" cy="15" r="1.6"></circle><circle cx="9" cy="15" r="1.6"></circle></svg>
		</button>
		<span class="tile tile-sm" aria-hidden="true" data-handle>
			<span data-kind></span>
			<img class="thumb" alt="" draggable="false" hidden />
		</span>
		<span class="nm">
			<span class="title"><b data-row-name></b><em class="st" hidden></em></span>
			<span class="meta"></span>
		</span>
		<span class="acts">
			<button class="ib" type="button" aria-pressed="false" aria-label={t("row.pin")} data-action="pin">
				<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6l-1 6 4 4H6l4-4-1-6zM12 13v8"></path></svg>
			</button>
			<button class="ib" type="button" aria-label={t("row.up")} data-action="up">
				<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
			</button>
			<button class="ib" type="button" aria-label={t("row.down")} data-action="down">
				<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
			</button>
			<button class="ib" type="button" aria-label={t("row.remove")} data-action="remove">
				<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
			</button>
		</span>
		<form class="unlock" hidden>
			<span class="field field-sm field-mono">
				<input type="password" name="password" autocomplete="off" spellcheck="false" aria-label={t("incoming.label")} />
			</span>
			<button class="btn btn-secondary btn-sm" type="submit">{t("incoming.open")}</button>
		</form>
	</li>
</template>

<style>
	.assembly {
		display: flex;
		flex-direction: column;
		gap: 14px;
		width: 100%;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		align-items: baseline;
		justify-content: space-between;
	}

	h2 {
		font-size: 34px;
	}

	.count {
		display: inline-grid;
		place-items: center;
		min-width: 28px;
		height: 28px;
		padding: 0 6px;
		background: var(--accent);
		color: var(--on-accent);
		font: 700 14px var(--font-mono);
		letter-spacing: 0;
		vertical-align: 6px;
	}

	.hint,
	.progress-text {
		font: 600 12px var(--font-mono);
		color: var(--ink-muted);
	}

	.stack {
		position: relative;
		isolation: isolate;
	}

	.slot {
		position: absolute;
		z-index: -1;
		right: 0;
		left: 0;
		border: var(--border) dashed var(--color-pacific);
		background: repeating-linear-gradient(
			45deg,
			transparent 0 8px,
			color-mix(in srgb, var(--color-pacific) 8%, transparent) 8px 16px
		);
	}

	.list {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.add {
		display: flex;
		gap: 8px;
		align-items: center;
		justify-content: center;
		height: 52px;
		border: var(--border) dashed var(--line);
		font: 600 13px var(--font-mono);
		color: var(--ink-muted);
	}

	.add[data-dragging] {
		border-style: solid;
		border-color: var(--accent);
		color: var(--accent);
	}

	svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: square;
	}

	/* Differs from the shared notice: centered, tighter and without its line height. */
	.done {
		align-items: center;
		padding: 10px 14px;
		line-height: normal;
	}

	.done span {
		flex: 1;
		overflow-wrap: anywhere;
	}

	.track span {
		width: var(--done, 0%);
		transition: width 200ms var(--ease-pop);
	}

	.progress-text {
		display: flex;
		justify-content: space-between;
		margin-top: 6px;
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 14px;
		align-items: flex-end;
		margin-top: 8px;
	}

	.name {
		flex: 1 1 260px;
	}

	@media (max-width: 520px) {
		h2 {
			font-size: 28px;
		}

		.bar .btn {
			flex: 1;
		}

		/* The fixed gear sits at the bottom-right corner; the button must not end under it. */
		.bar {
			padding-right: calc(52px + 16px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track span {
			transition: none;
		}
	}

	/* Rows: index, grip, type tile, name with its state tag, and pin · ↑ · ↓ · ×. Cloned from the
	   <template> above, so this file's scope reaches them. */
	.row {
		position: relative;
		display: grid;
		grid-template-columns: 34px 20px 40px 1fr auto;
		gap: 0 14px;
		align-items: center;
		min-height: 64px;
		padding: 8px 12px;
		border: var(--border) solid var(--surface);
		background: var(--bg);
	}

	.row[data-pinned] {
		border-color: var(--accent);
	}

	.row[data-state="failed"] {
		border-color: var(--ink);
	}

	.row[data-state="locked"] {
		border-color: var(--accent);
	}

	.row .ix {
		font: 600 12px var(--font-mono);
		color: var(--ink-muted);
	}

	.row[data-pinned] .ix {
		color: var(--accent);
	}

	.row .pinmark,
	.row .mtag {
		position: absolute;
		top: -9px;
		left: 10px;
		padding: 0 6px;
		background: var(--accent);
		color: var(--on-accent);
		font: 700 10px var(--font-mono);
		letter-spacing: 0.08em;
	}

	/* Handles: the grip on desktop, the type tile on phones. Touch drags must not scroll the page. */
	.row .grip {
		display: grid;
		place-items: center;
		width: 20px;
		height: 40px;
		color: var(--color-pacific);
		cursor: grab;
		touch-action: none;
	}

	.row .grip svg {
		fill: currentColor;
	}

	.row .grip:disabled {
		opacity: 0.25;
		cursor: default;
	}

	.row .tile {
		position: relative;
		font-size: 9px;
		touch-action: none;
	}

	.row[data-pinned] .tile {
		touch-action: auto;
	}

	/* An image shows itself; the tile keeps its border and, on phones, the grip badge above it. */
	.row .thumb {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	/* Lifted by the pointer: follows it 1:1 through `translate`; the riso tilt lives in `transform`. */
	.row.lift {
		z-index: 2;
		border-color: var(--accent);
		background: var(--surface);
		box-shadow: -6px 6px 0 var(--accent);
		transform: rotate(-1.2deg) translate(12px, -6px);
		cursor: grabbing;
	}

	.row.kbd {
		z-index: 2;
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	.row.lift .ib,
	.row.kbd .ib {
		border-color: var(--surface);
		color: var(--color-pacific);
	}

	.row.shifting {
		transition:
			translate 200ms ease-out,
			transform 200ms ease-out,
			box-shadow 200ms ease-out;
	}

	@media (prefers-reduced-motion: reduce) {
		.row.shifting {
			transition: none;
		}
	}

	.row[data-state="checking"] .tile {
		opacity: 0.45;
	}

	.row .nm {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 2px;
	}

	.row .title {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 8px;
		align-items: center;
	}

	.row b {
		font-size: 15px;
		overflow-wrap: anywhere;
	}

	.row[data-state="failed"] .meta,
	.row .meta[data-error] {
		color: var(--ink);
	}

	.row .st {
		padding: 1px 6px;
		font: 700 10px var(--font-mono);
		font-style: normal;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.row[data-state="checking"] .st {
		border: 1.5px solid var(--line);
		color: var(--ink-muted);
	}

	.row[data-state="failed"] .st {
		background: var(--ink);
		color: var(--bg);
	}

	.row[data-state="locked"] .st {
		border: 1.5px solid var(--accent);
		color: var(--accent);
	}

	.row .acts {
		display: flex;
		gap: 6px;
	}

	.row .ib {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: var(--border) solid transparent;
		color: var(--ink-muted);
	}

	.row .ib svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: square;
	}

	.row .ib:disabled {
		opacity: 0.3;
		cursor: default;
	}

	.row .ib[aria-pressed="true"] {
		background: var(--accent);
		color: var(--on-accent);
	}

	@media (hover: hover) and (pointer: fine) {
		.row .ib:not(:disabled):hover {
			border-color: var(--surface);
			color: var(--ink);
		}

		/* Pressed pin: stays lime with dark ink; the hover only outlines it. */
		.row .ib[aria-pressed="true"]:not(:disabled):hover {
			border-color: var(--color-midnight);
			color: var(--on-accent);
		}
	}

	.row .unlock {
		display: flex;
		grid-column: 4 / -1;
		gap: 10px;
		margin-top: 10px;
	}

	.row .unlock .field {
		flex: 1;
		max-width: 340px;
	}

	/* Phones: name and tag on one column, actions on their own line below. */
	@media (max-width: 520px) {
		.row {
			grid-template-columns: 40px 1fr;
			gap: 10px 12px;
			padding: 12px;
		}

		.row .ix,
		.row .grip {
			display: none;
		}

		.row.lift {
			transform: rotate(-1.2deg) translate(3px, -4px);
		}

		/* The tile is the handle here; a small grip badge says so. */
		.row:not([data-pinned]) .tile::after {
			position: absolute;
			right: 1px;
			bottom: 1px;
			width: 14px;
			height: 14px;
			background:
				radial-gradient(circle, var(--color-pacific) 1px, transparent 1.5px) 1px 1px / 4px 4px,
				var(--color-midnight);
			content: "";
		}

		.row .acts {
			grid-column: 2;
		}

		.row .ib {
			width: 44px;
			height: 44px;
			border-color: var(--surface);
		}

		.row .unlock {
			grid-column: 1 / -1;
		}

		.row .unlock .field {
			max-width: none;
		}
	}
</style>
