---
import { routeLocale, translator } from "../../../i18n/translate.ts";

const lang = routeLocale(Astro.currentLocale);
const t = translator(lang);
const eye = "M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z";
---

<kn-dialogs>
	<dialog class="dlg" aria-labelledby="single-title" data-dialog="single">
		<form method="dialog">
			<h2 class="display" id="single-title">{t("single.title")}</h2>
			<div class="file">
				<span class="tile tile-dark" aria-hidden="true">PDF</span>
				<span><b data-name></b><span class="meta" data-meta></span></span>
			</div>
			<dl>
				<dt class="label">{t("settings.size")}</dt>
				<dd><span data-size></span> <small data-fit></small></dd>
				<dt class="label">{t("settings.quality")}</dt>
				<dd data-quality></dd>
				<dt class="label">{t("settings.password")}</dt>
				<dd data-password></dd>
				<dt class="label">{t("single.result")}</dt>
				<dd data-result></dd>
			</dl>
			<p class="question">{t("single.question")}</p>
			<div class="actions">
				<button class="btn-ghost" type="button" data-back>{t("single.back")}</button>
				<button class="btn btn-secondary" value="more">{t("single.more")}</button>
				<button class="btn btn-primary" value="confirm" autofocus>{t("single.confirm")}</button>
			</div>
		</form>
	</dialog>

	<dialog class="dlg" role="alertdialog" aria-labelledby="summary-title" data-dialog="summary">
		<form method="dialog">
			<h2 class="display" id="summary-title" data-title></h2>
			<ul class="fails" data-fails></ul>
			<p class="question" data-body></p>
			<div class="actions">
				<button class="btn btn-secondary" type="button" data-back autofocus>{t("summary.back")}</button>
				<button class="btn btn-primary" value="confirm">{t("summary.without")}</button>
			</div>
		</form>
	</dialog>

	<template data-fail-template>
		<li><span class="tile tile-sm" aria-hidden="true"></span><span><b></b><span class="meta"></span></span></li>
	</template>

	<dialog class="dlg" aria-labelledby="incoming-title" data-dialog="incoming">
		<form method="dialog">
			<h2 class="display" id="incoming-title" data-title></h2>
			<div class="file">
				<span class="tile tile-dark" aria-hidden="true" data-kind></span>
				<span><b data-name></b><span class="meta">{t("incoming.protected")}</span></span>
			</div>
			<label class="field-group">
				<span class="label">{t("incoming.label")}</span>
				<span class="field field-mono">
					<input type="password" name="password" autocomplete="off" spellcheck="false" autofocus />
				</span>
				<span class="error" role="alert" data-error></span>
			</label>
			<p class="notice notice-accent">
				<span>{t("incoming.warn.start")} <b>{t("incoming.warn.strong")}</b>{t("incoming.warn.end")}</span>
			</p>
			<div class="actions">
				<button class="btn-ghost" type="button" data-back>{t("incoming.cancel")}</button>
				<button class="btn btn-primary" value="confirm">{t("incoming.open")}</button>
			</div>
		</form>
	</dialog>

	<dialog class="dlg" aria-labelledby="result-title" data-dialog="result">
		<form method="dialog">
			<h2 class="display" id="result-title">{t("result.title")}</h2>
			<div class="file">
				<span class="tile tile-pdf" aria-hidden="true">PDF</span>
				<span><b data-name></b><span class="meta" data-meta></span></span>
			</div>
			{
				(["password", "repeat"] as const).map((name) => (
					<label class="field-group">
						<span class="label">{t(name === "password" ? "result.label" : "result.repeat")}</span>
						<span class="field field-mono">
							<input
								type="password"
								name={name}
								autocomplete="new-password"
								spellcheck="false"
								autofocus={name === "password"}
							/>
							<button
								class="eye"
								type="button"
								aria-label={t("password.show")}
								aria-pressed="false"
								data-reveal
							>
								<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
									<path d={eye}></path>
								</svg>
							</button>
						</span>
					</label>
				))
			}
			<span class="error" role="alert" data-error></span>
			<p class="notice notice-accent">
				<span>{t("result.warn.start")} <b>{t("result.warn.strong")}</b></span>
			</p>
			<div class="actions">
				<button class="btn-ghost" type="button" data-back>{t("result.back")}</button>
				<button class="btn btn-primary" value="confirm">{t("result.confirm")}</button>
			</div>
		</form>
	</dialog>
</kn-dialogs>

<script>
	import { defineOnce } from "../../../lib/dom.ts";
	import { DialogsElement } from "./element.ts";

	defineOnce("kn-dialogs", DialogsElement);
</script>

<style>
	/* The element only carries behavior; its children lay out as if it were not there. */
	kn-dialogs {
		display: contents;
	}

	.file {
		display: flex;
		align-items: center;
		gap: 14px;
		overflow-wrap: anywhere;
	}

	.meta {
		display: block;
	}

	dl {
		display: grid;
		grid-template-columns: 112px 1fr;
		gap: 10px 16px;
		padding: 14px 0;
		border-block: var(--border) solid var(--bg);
		font-size: 15px;
	}

	dt {
		padding-top: 3px;
	}

	dd {
		margin: 0;
		overflow-wrap: anywhere;
	}

	small {
		font-size: 13px;
		color: var(--ink-muted);
	}

	.fails {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.fails li {
		display: flex;
		gap: 14px;
		align-items: center;
		padding: 10px 14px;
		border: var(--border) solid var(--ink);
		background: var(--bg);
		overflow-wrap: anywhere;
	}

	.eye {
		display: grid;
		place-items: center;
		width: 48px;
		border-left: var(--border) solid var(--surface);
		color: var(--ink-muted);
	}

	.eye svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.eye[aria-pressed="true"] {
		color: var(--accent);
	}

	.error {
		font: 500 12px var(--font-mono);
		color: var(--ink);
	}

	.error:empty {
		display: none;
	}

	@media (max-width: 520px) {
		dl {
			grid-template-columns: 96px 1fr;
			font-size: 14px;
		}
	}
</style>
