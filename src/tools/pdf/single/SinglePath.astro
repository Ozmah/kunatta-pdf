---
import { routeLocale, translate } from "../../../i18n/translate.ts";

const lang = routeLocale(Astro.currentLocale);
---

<kn-single>
	<section class="riso-card state" hidden data-view="converting" aria-busy="true">
		<div class="pair" aria-hidden="true">
			<span class="tile tile-lg" data-kind-label></span>
			<svg width="56" height="16" viewBox="0 0 56 16"><path d="M2 8h48M42 2l8 6-8 6"></path></svg>
			<span class="tile tile-lg tile-pdf">PDF</span>
		</div>
		<h2 class="display" tabindex="-1">{translate(lang, "fast.converting")}</h2>
		<p class="file" data-source-name></p>
		<div class="track bar" role="progressbar" aria-label={translate(lang, "fast.converting")}>
			<span></span>
		</div>
	</section>

	<section class="riso-card state" hidden data-view="done">
		<span class="tile tile-xl tile-pdf" aria-hidden="true">PDF</span>
		<h2 class="display" tabindex="-1">{translate(lang, "fast.done")}</h2>
		<p class="file" data-result></p>
		<div class="actions">
			<button class="btn btn-secondary" type="button" data-download-again>
				<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 4v11M6 10l6 6 6-6M4 20h16"></path>
				</svg>
				{translate(lang, "fast.again")}
			</button>
			<button class="btn-ghost" type="button" data-another>{translate(lang, "fast.another")}</button>
		</div>
	</section>

	<section class="riso-card state" hidden data-view="failed">
		<span class="tile tile-xl" aria-hidden="true">
			<span data-failed-kind></span>
			<svg class="xmark" width="16" height="16" viewBox="0 0 24 24">
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</span>
		<h2 class="display" tabindex="-1">{translate(lang, "fast.failed")}</h2>
		<p class="file" data-failure></p>
		<div class="actions">
			<button class="btn btn-secondary" type="button" data-retry>{translate(lang, "fast.retry")}</button>
			<button class="btn-ghost" type="button" data-pick-another>{translate(lang, "fast.pick")}</button>
		</div>
	</section>
</kn-single>

<script>
	import { defineOnce } from "../../../lib/dom.ts";
	import { SingleElement } from "./element.ts";

	defineOnce("kn-single", SingleElement);
</script>

<style>
	/* The element only carries behavior; its children lay out as if it were not there. */
	kn-single {
		display: contents;
	}

	.state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 14px;
		width: 100%;
		min-height: 400px;
		padding: 32px 24px;
		text-align: center;
	}

	[data-view="failed"]::after {
		border-color: var(--ink);
	}

	h2 {
		font-size: 40px;
		line-height: 1.05;
	}

	.file {
		max-width: 100%;
		font: 500 13px var(--font-mono);
		overflow-wrap: anywhere;
	}

	.pair {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.pair svg {
		fill: none;
		stroke: var(--line);
		stroke-width: 2.5;
		stroke-linecap: square;
	}

	/* Holds the × of a failed file. */
	.tile {
		position: relative;
	}

	.tile-pdf {
		transform: rotate(-3deg);
	}

	.xmark {
		position: absolute;
		top: -12px;
		right: -12px;
		width: 28px;
		height: 28px;
		padding: 4px;
		border: var(--border) solid var(--color-midnight);
		background: var(--color-cheviot);
		fill: none;
		stroke: var(--color-midnight);
		stroke-width: 2.6;
	}

	/* Indeterminate: the worker reports no percentage for a single file, so none is invented. */
	.bar {
		width: min(380px, 100%);
		margin-top: 6px;
		overflow: hidden;
	}

	.bar span {
		width: 35%;
		animation: travel 1.2s var(--ease-spin) infinite alternate;
	}

	@keyframes travel {
		to {
			transform: translateX(186%);
		}
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 18px;
		align-items: center;
		justify-content: center;
		margin-top: 14px;
	}

	@media (max-width: 520px) {
		h2 {
			font-size: 32px;
		}

		.actions {
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bar span {
			width: 100%;
			opacity: 0.6;
			animation: none;
		}
	}
</style>
