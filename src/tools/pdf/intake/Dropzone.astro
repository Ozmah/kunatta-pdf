---
import { routeLocale, translate } from "../../../i18n/translate.ts";
import Fan from "../shared/Fan.astro";
import { pickerAccept } from "../shared/file-kinds.ts";

const lang = routeLocale(Astro.currentLocale);
---

<kn-dropzone>
	<div class="flow" role="img" aria-label={translate(lang, "flow.label")} data-flow>
		<span class="tile any"></span>
		<svg width="56" height="16" viewBox="0 0 56 16" aria-hidden="true">
			<path d="M2 8h48M42 2l8 6-8 6"></path>
		</svg>
		<span class="tile tile-pdf result">PDF</span>
	</div>

	<div class="notice" role="status" hidden data-notice>
		<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
			<rect x="3" y="3" width="18" height="18"></rect>
			<path d="M12 11v6M12 7v1"></path>
		</svg>
		<span data-notice-text></span>
	</div>

	<label class="riso-card drop" data-dropzone data-empty-drop>
		<input class="sr-only" type="file" multiple accept={pickerAccept} data-picker />
		<Fan />
		<span class="display title">{translate(lang, "drop.title")}</span>
		<span class="hint">
			{translate(lang, "drop.paste")} <kbd class="keycap" data-modifier>Ctrl</kbd> <kbd class="keycap">V</kbd>
		</span>
	</label>

	<button class="btn btn-secondary" type="button" data-compose>
		<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h9l3 3v11H8zM4 7v14h12"></path></svg>
		{translate(lang, "drop.compose")}
	</button>
</kn-dropzone>

<script>
	import { defineOnce } from "../../../lib/dom.ts";
	import { DropzoneElement } from "./element.ts";

	defineOnce("kn-dropzone", DropzoneElement);
</script>

<style>
	/* The element only carries behavior; its children lay out as if it were not there. */
	kn-dropzone {
		display: contents;
	}

	.flow {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.flow svg {
		fill: none;
		stroke: var(--color-pacific);
		stroke-width: 2.5;
		stroke-linecap: square;
	}

	.any {
		position: relative;
		box-shadow: -3px 3px 0 var(--color-grape);
	}

	.any::before {
		content: "";
		position: absolute;
		inset: 14px 8px 10px;
		background: repeating-linear-gradient(var(--color-grape) 0 2px, transparent 2px 7px);
	}

	.result {
		box-shadow: -3px 3px 0 var(--color-neptune);
		transform: rotate(-3deg);
	}

	.drop {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		width: 100%;
		height: 400px;
		padding: 24px;
		text-align: center;
		cursor: pointer;
	}

	/* Something can be dropped here: a dashed outline. */
	.drop::after {
		border-style: dashed;
	}

	.drop:has(input:focus-visible)::after,
	.drop[data-dragging]::after {
		border-style: solid;
		border-color: var(--accent);
	}

	.title {
		font-size: 40px;
	}

	.hint {
		font-size: 15px;
		color: var(--ink-muted);
	}

	@media (pointer: coarse) {
		.hint {
			display: none;
		}
	}

	/* Phones: a shorter drop zone leaves room for "Juntar varios" above the footer. */
	@media (max-width: 520px) {
		.drop {
			height: 340px;
		}

		[data-compose] {
			width: 100%;
		}
	}
</style>
