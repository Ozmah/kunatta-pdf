---
import { routeLocale, translate } from "../../../i18n/translate.ts";
import { defaultSettings, passwordModes } from "../shared/settings.ts";
import { pageSizes, qualities } from "../contract/options.ts";

const lang = routeLocale(Astro.currentLocale);
---

<div class="settings" data-settings>
	<form
		class="panel"
		id="pdf-settings"
		aria-label={translate(lang, "settings.group")}
		data-settings-panel
	>
		<label class="name">
			<span class="label">{translate(lang, "settings.name")}</span>
			<span class="field field-sm">
				<input
					type="text"
					name="name"
					maxlength="200"
					spellcheck="false"
					autocomplete="off"
					placeholder={translate(lang, "settings.name.placeholder")}
					data-pdf-name
				/>
				<span class="field-suffix" aria-hidden="true">.pdf</span>
			</span>
		</label>
		<fieldset>
			<legend class="label">{translate(lang, "settings.size")}</legend>
			<div class="segments">
				{
					pageSizes.map((size) => (
						<label>
							<input
								type="radio"
								name="size"
								value={size}
								checked={size === defaultSettings.size}
							/>
							<span>{translate(lang, `settings.size.${size}`)}</span>
						</label>
					))
				}
			</div>
		</fieldset>
		<fieldset>
			<legend class="label">{translate(lang, "settings.quality")}</legend>
			<div class="segments">
				{
					qualities.map((quality) => (
						<label>
							<input
								type="radio"
								name="quality"
								value={quality}
								checked={quality === defaultSettings.quality}
							/>
							<span>{translate(lang, `settings.quality.${quality}`)}</span>
						</label>
					))
				}
			</div>
		</fieldset>
		<fieldset>
			<legend class="label">{translate(lang, "settings.password")}</legend>
			<div class="segments">
				{
					passwordModes.map((mode) => (
						<label>
							<input
								type="radio"
								name="password"
								value={mode}
								checked={mode === defaultSettings.password}
							/>
							<span>{translate(lang, `settings.password.${mode}`)}</span>
						</label>
					))
				}
			</div>
			<p class="note">{translate(lang, "settings.password.note")}</p>
		</fieldset>
	</form>

	<button
		class="gear"
		type="button"
		aria-label={translate(lang, "settings.open")}
		aria-controls="pdf-settings"
		aria-expanded="false"
		data-gear
	>
		<svg
			width="22"
			height="22"
			viewBox="0 0 24 24"
			fill="none"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="12" cy="12" r="3"></circle>
			<path
				d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68 1.65 1.65 0 0 0 10 3.17V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
			></path>
		</svg>
	</button>
</div>

<style>
	/* The gear and panel are fixed to the viewport; the wrapper must not take a layout slot. */
	.settings {
		display: contents;
	}

	/* Gear: closed at -4deg; open turns into a diamond. Press sinks into its riso shadow. */
	.gear {
		position: fixed;
		right: 32px;
		bottom: 32px;
		z-index: var(--z-gear);
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		background: var(--surface);
		box-shadow: var(--riso-shadow-x) var(--riso-shadow-y) 0 var(--accent);
		--turn: -4deg;
		transform: rotate(var(--turn));
		transition:
			transform var(--duration-spin-close) var(--ease-spin),
			background-color var(--duration-color) ease,
			box-shadow 120ms var(--ease-press);
	}

	.gear svg {
		stroke: var(--accent);
		transition:
			transform var(--duration-spin-close) var(--ease-spin),
			stroke var(--duration-color) ease;
	}

	[data-open] .gear {
		--turn: 41deg;
		background: var(--accent);
		box-shadow: var(--riso-shadow-x) var(--riso-shadow-y) 0 var(--color-grape);
		transition:
			transform var(--duration-spin-open) var(--ease-spin),
			background-color var(--duration-color) ease,
			box-shadow 120ms var(--ease-press);
	}

	[data-open] .gear svg {
		stroke: var(--on-accent);
		transform: rotate(90deg);
		transition:
			transform var(--duration-spin-open) var(--ease-spin),
			stroke var(--duration-color) ease;
	}

	.gear:active {
		transform: rotate(var(--turn)) translate(-3px, 3px) scale(0.97);
		box-shadow: -1px 1px 0 var(--accent);
		transition:
			transform var(--duration-press) var(--ease-press),
			box-shadow var(--duration-press) var(--ease-press);
	}

	[data-open] .gear:active {
		box-shadow: -1px 1px 0 var(--color-grape);
	}

	@media (hover: hover) and (pointer: fine) {
		.settings:not([data-open]) .gear:hover svg {
			transform: rotate(30deg);
		}
	}

	.gear:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 4px;
	}

	/* Panel: grows from the gear; the grape riso layer lands 40ms later. */
	.panel {
		position: fixed;
		right: 32px;
		bottom: 104px;
		z-index: var(--z-panel);
		isolation: isolate;
		display: flex;
		flex-direction: column;
		gap: 18px;
		width: 262px;
		padding: 18px;
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px) scale(0.97);
		transform-origin: 100% 100%;
		transition:
			opacity var(--duration-pop-out) var(--ease-press),
			transform var(--duration-pop-out) var(--ease-press),
			visibility 0s var(--duration-pop-out);
	}

	.panel::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -2;
		background: var(--color-grape);
		transition: transform var(--duration-pop-out) var(--ease-press);
	}

	.panel::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--surface);
		border: var(--border-strong) solid var(--line);
	}

	[data-open] .panel {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition:
			opacity 180ms ease-out,
			transform var(--duration-pop-in) var(--ease-pop),
			visibility 0s;
	}

	[data-open] .panel::before {
		transform: var(--riso-layer);
		transition: transform var(--duration-pop-in) var(--ease-pop) var(--delay-riso);
	}

	[data-instant] .gear,
	[data-instant] .gear svg,
	[data-instant] .panel,
	[data-instant] .panel::before {
		transition: none;
	}

	fieldset {
		border: 0;
		padding: 0;
	}

	/* Differs from the shared label: 12px with the token tracking (0.12em) instead of 11px · 0.1em. */
	.label {
		display: block;
		margin-bottom: 8px;
		font-size: 12px;
		letter-spacing: var(--tracking-label);
	}

	.segments {
		display: flex;
		border: var(--border) solid var(--line);
		background: var(--bg);
	}

	.segments label {
		position: relative;
		flex: 1;
	}

	.segments label + label {
		border-left: var(--border) solid var(--line);
	}

	.segments input {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		cursor: pointer;
	}

	.segments span {
		display: block;
		padding: 9px 0;
		text-align: center;
		font-size: 14px;
		font-weight: 700;
		transition:
			background-color 120ms ease,
			color 120ms ease;
	}

	.segments input:checked + span {
		background: var(--accent);
		color: var(--on-accent);
	}

	.segments input:focus-visible + span {
		outline: 2.5px solid var(--focus);
		outline-offset: -6px;
	}

	/* Differs from the shared suffix: a pacific border and 600 12px. */
	.field-suffix {
		padding: 0 10px;
		border-left-color: var(--line);
		font: 600 12px var(--font-mono);
	}

	.note {
		margin-top: 8px;
		font: 500 11px var(--font-mono);
		color: var(--ink-muted);
	}

	/* Reduced motion keeps color and opacity, drops rotation, scale and offsets. */
	@media (prefers-reduced-motion: reduce) {
		.gear,
		[data-open] .gear,
		.gear:active {
			transform: rotate(-4deg);
			transition:
				background-color var(--duration-color) ease,
				box-shadow var(--duration-color) ease;
		}

		.gear svg,
		[data-open] .gear svg,
		.settings:not([data-open]) .gear:hover svg {
			transform: none;
			transition: stroke var(--duration-color) ease;
		}

		.panel,
		[data-open] .panel {
			transform: none;
		}

		.panel::before,
		[data-open] .panel::before {
			transform: var(--riso-layer);
			transition: none;
		}
	}
</style>
