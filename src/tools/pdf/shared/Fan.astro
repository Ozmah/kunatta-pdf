---
/** The fan of file cards over the drop zone and the empty list; it lifts while files hover it. */
const cards = [
	{ label: "JPG", tone: "grape", place: "translate(-118px, 12px) rotate(-16deg)" },
	{ label: "DOCX", tone: "cheviot", place: "translate(-60px, -2px) rotate(-7deg)" },
	{ label: "PPTX", tone: "pacific", place: "translateY(-10px) rotate(-1deg)" },
	{ label: "XLSX", tone: "cheviot", place: "translate(60px, -2px) rotate(8deg)" },
	{ label: "PNG", tone: "grape", place: "translate(118px, 12px) rotate(17deg)" },
] as const;
---

<span class="fan" aria-hidden="true">
	{
		cards.map((card, index) => (
			<span
				class={`tile tile-lg card ${card.tone}`}
				style={`--place: ${card.place}; z-index: ${index === 2 ? 2 : index % 2}`}
			>
				{card.label}
			</span>
		))
	}
</span>

<style>
	.fan {
		position: relative;
		width: 320px;
		height: 120px;
		margin-bottom: 16px;
		transition: transform 200ms var(--ease-pop);
	}

	:global([data-dragging]) .fan {
		transform: translateY(-6px) scale(1.04);
	}

	/* Differs from the shared large tile: 600 11px instead of 700 12px. */
	.card {
		position: absolute;
		bottom: 0;
		left: 50%;
		margin-left: -31px;
		font: 600 11px var(--font-mono);
		transform: var(--place);
	}

	.card.grape {
		background: var(--color-grape);
	}

	.card.cheviot {
		background: var(--color-cheviot);
	}

	.card.pacific {
		background: var(--color-pacific);
	}

	@media (prefers-reduced-motion: reduce) {
		.fan {
			transition: none;
		}

		:global([data-dragging]) .fan {
			transform: none;
		}
	}
</style>
