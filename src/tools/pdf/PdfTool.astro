---
import Assembly from "./assembly/Assembly.astro";
import Dialogs from "./dialogs/Dialogs.astro";
import Dropzone from "./intake/Dropzone.astro";
import Settings from "./settings/Settings.astro";
import SinglePath from "./single/SinglePath.astro";
---

<section class="tool" data-tool>
	<Dropzone />
	<SinglePath />
	<Assembly />
</section>
<Settings />
<Dialogs />

<script>
	import { startPdfTool } from "./index.ts";

	startPdfTool(document);
</script>

<style>
	.tool {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 34px;
		width: min(640px, 100%);
	}

	/* The list needs room for its row actions. */
	.tool:has([data-assembly]:not([hidden])) {
		width: min(760px, 100%);
	}
</style>
