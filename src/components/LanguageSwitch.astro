---
import { getRelativeLocaleUrl } from "astro:i18n";

import { localeNames, locales } from "../i18n/locales.ts";
import { routeLocale, translate } from "../i18n/translate.ts";

const lang = routeLocale(Astro.currentLocale);

// The same page in the other language: Astro builds both prefixes, so only the locale changes.
const home = getRelativeLocaleUrl(lang);
const rest = Astro.url.pathname.startsWith(home) ? Astro.url.pathname.slice(home.length) : "";
---

<kn-language-switch>
	<nav class="lang" aria-label={translate(lang, "lang.label")} data-lang-switch>
		{
			locales.map((code) => (
				<a
					href={getRelativeLocaleUrl(code, rest)}
					hreflang={code}
					lang={code}
					aria-label={localeNames[code]}
					aria-current={code === lang ? "page" : undefined}
				>
					{code.toUpperCase()}
				</a>
			))
		}
	</nav>

	<dialog class="dlg" role="alertdialog" aria-labelledby="language-title" data-dialog="language">
		<form method="dialog">
			<h2 class="display" id="language-title" data-title></h2>
			<p class="question">{translate(lang, "language.body")}</p>
			<div class="actions">
				<button class="btn btn-secondary" type="button" data-back autofocus>{translate(lang, "language.stay")}</button>
				<button class="btn btn-primary" value="confirm" data-switch></button>
			</div>
		</form>
	</dialog>
</kn-language-switch>

<script>
	import { defineOnce } from "../lib/dom.ts";
	import { LanguageSwitchElement } from "./language-switch.ts";

	defineOnce("kn-language-switch", LanguageSwitchElement);
</script>

<style>
	/* The element only carries behavior; its children lay out as if it were not there. */
	kn-language-switch {
		display: contents;
	}

	/* The active language is a lime riso tile, tilted, with a grape layer. */
	.lang {
		display: flex;
		gap: 6px;
	}

	a {
		display: grid;
		place-items: center;
		width: 40px;
		height: 34px;
		border: var(--border) solid var(--surface);
		color: var(--ink-muted);
		font: 700 12px var(--font-mono);
		letter-spacing: 0.06em;
		text-decoration: none;
		transition:
			color var(--duration-color) ease,
			border-color var(--duration-color) ease;
	}

	a[aria-current="page"] {
		border-color: var(--color-midnight);
		background: var(--accent);
		box-shadow: -3px 3px 0 var(--color-grape);
		color: var(--on-accent);
		transform: rotate(-3deg);
	}

	@media (hover: hover) and (pointer: fine) {
		a:not([aria-current]):hover {
			border-color: var(--line);
			color: var(--ink);
		}
	}

	a:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 3px;
	}

	/* Reduced motion keeps color; the tilt goes, the riso layer stays. */
	@media (prefers-reduced-motion: reduce) {
		a[aria-current="page"] {
			transform: none;
		}
	}
</style>
