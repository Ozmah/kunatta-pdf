---
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a class="logo" href={href}>
	<svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
		<g transform="rotate(-8 32 32)">
			<polygon points="11,9 37,9 47,19 47,61 11,61" fill="var(--color-lime)"></polygon>
			<polygon
				points="14,6 40,6 50,16 50,58 14,58"
				fill="var(--color-cheviot)"
				stroke="var(--color-midnight)"
				stroke-width="3"></polygon>
			<polyline points="40,6 40,16 50,16" fill="none" stroke="var(--color-midnight)" stroke-width="3"
			></polyline>
		</g>
		<g transform="translate(3 4) scale(2.45)">
			<path
				d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
				fill="var(--color-lime)"
				stroke="var(--color-midnight)"
				stroke-width="1.2"
				stroke-linejoin="round"></path>
		</g>
	</svg>
	<span>kunatta</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		text-decoration: none;
		font-weight: 800;
		font-size: 20px;
		letter-spacing: -0.04em;
	}
</style>
