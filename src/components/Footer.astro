---
import { routeLocale, translate } from "../i18n/translate.ts";

const lang = routeLocale(Astro.currentLocale);
---

<footer class="footer">
	<span>{translate(lang, "footer.notice")}</span>
	<span class="links">
		<a class="author" href="https://ozmah.dev" target="_blank" rel="noopener noreferrer"
			>{translate(lang, "footer.author")}</a
		>
		<a
			class="repo"
			href="https://github.com/Ozmah/kunatta"
			target="_blank"
			rel="noopener noreferrer"
			aria-label={translate(lang, "footer.repo")}
		>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
				<path
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
				></path>
			</svg>
		</a>
	</span>
</footer>

<style>
	.footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 14px;
		/* The fixed gear sits 32 px from the bottom-right corner and is 52 px wide. */
		padding-right: calc(32px + 52px + 16px);
		font: 500 12px var(--font-mono);
		color: var(--ink-muted);
	}

	.links {
		display: flex;
		gap: 10px;
		align-items: center;
	}

	a {
		transition:
			color var(--duration-color) ease,
			border-color var(--duration-color) ease;
	}

	a:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 3px;
	}

	.author {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 4px;
	}

	/* A square chip like the inactive language tiles. */
	.repo {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border: var(--border) solid var(--surface);
		color: var(--ink-muted);
	}

	@media (hover: hover) and (pointer: fine) {
		.author:hover {
			color: var(--accent);
		}

		.repo:hover {
			border-color: var(--line);
			color: var(--ink);
		}
	}
</style>
