---
import type { Locale } from "../i18n/locales.ts";
import Assembly from "./Assembly.astro";
import FastPath from "./FastPath.astro";
import { translate } from "../i18n/translate.ts";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;

// What the picker offers. Content is still verified by signature after selection.
const accept = [
	"image/jpeg",
	"image/png",
	"image/webp",
	"application/pdf",
	"text/plain",
	".txt",
	".doc",
	".docx",
	".xls",
	".xlsx",
	".ppt",
	".pptx",
].join(",");

const cards = [
	{ label: "JPG", tone: "grape", place: "translate(-118px, 12px) rotate(-16deg)" },
	{ label: "DOCX", tone: "cheviot", place: "translate(-60px, -2px) rotate(-7deg)" },
	{ label: "PPTX", tone: "pacific", place: "translateY(-10px) rotate(-1deg)" },
	{ label: "XLSX", tone: "cheviot", place: "translate(60px, -2px) rotate(8deg)" },
	{ label: "PNG", tone: "grape", place: "translate(118px, 12px) rotate(17deg)" },
] as const;
---

<section class="tool" data-tool>
	<div class="flow" role="img" aria-label={translate(lang, "flow.label")} data-flow>
		<span class="tile any"></span>
		<svg width="56" height="16" viewBox="0 0 56 16" aria-hidden="true">
			<path d="M2 8h48M42 2l8 6-8 6"></path>
		</svg>
		<span class="tile tile-pdf result">PDF</span>
	</div>

	<div class="notice" role="status" hidden data-notice>
		<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
			<rect x="3" y="3" width="18" height="18"></rect>
			<path d="M12 11v6M12 7v1"></path>
		</svg>
		<span data-notice-text></span>
	</div>

	<label class="riso-card drop" data-dropzone data-empty-drop>
		<input class="sr-only" type="file" multiple accept={accept} data-picker />
		<span class="fan" aria-hidden="true">
			{
				cards.map((card, index) => (
					<span
						class={`tile tile-lg card ${card.tone}`}
						style={`--place: ${card.place}; z-index: ${index === 2 ? 2 : index % 2}`}
					>
						{card.label}
					</span>
				))
			}
		</span>
		<span class="display title">{translate(lang, "drop.title")}</span>
		<span class="hint">
			{translate(lang, "drop.paste")} <kbd data-modifier>Ctrl</kbd> <kbd>V</kbd>
		</span>
	</label>

	<FastPath lang={lang} />
	<Assembly lang={lang} />
</section>

<style>
	.tool {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 34px;
		width: min(640px, 100%);
	}

	.tool:has([data-assembly]:not([hidden])) {
		width: min(760px, 100%);
	}

	.flow {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.flow svg {
		fill: none;
		stroke: var(--color-pacific);
		stroke-width: 2.5;
		stroke-linecap: square;
	}

	.any {
		position: relative;
		box-shadow: -3px 3px 0 var(--color-grape);
	}

	.any::before {
		content: "";
		position: absolute;
		inset: 14px 8px 10px;
		background: repeating-linear-gradient(var(--color-grape) 0 2px, transparent 2px 7px);
	}

	.result {
		box-shadow: -3px 3px 0 var(--color-neptune);
		transform: rotate(-3deg);
	}

	.drop {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		width: 100%;
		height: 400px;
		padding: 24px;
		text-align: center;
		cursor: pointer;
	}

	/* Something can be dropped here: a dashed outline. */
	.drop::after {
		border-style: dashed;
	}

	.drop:has(input:focus-visible)::after,
	.drop[data-dragging]::after {
		border-style: solid;
		border-color: var(--accent);
	}

	.fan {
		position: relative;
		width: 320px;
		height: 120px;
		margin-bottom: 16px;
		transition: transform 200ms var(--ease-pop);
	}

	.drop[data-dragging] .fan {
		transform: translateY(-6px) scale(1.04);
	}

	/* Differs from the shared large tile: 600 11px instead of 700 12px. */
	.card {
		position: absolute;
		bottom: 0;
		left: 50%;
		margin-left: -31px;
		font: 600 11px var(--font-mono);
		transform: var(--place);
	}

	.card.grape {
		background: var(--color-grape);
	}

	.card.cheviot {
		background: var(--color-cheviot);
	}

	.card.pacific {
		background: var(--color-pacific);
	}

	.title {
		font-size: 40px;
	}

	.hint {
		font-size: 15px;
		color: var(--ink-muted);
	}

	kbd {
		padding: 2px 7px;
		border: 1.5px solid var(--line);
		background: var(--bg);
		box-shadow: -2px 2px 0 var(--bg);
		font: 500 12px var(--font-mono);
		color: var(--ink);
	}

	@media (pointer: coarse) {
		.hint {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fan {
			transition: none;
		}

		.drop[data-dragging] .fan {
			transform: none;
		}
	}
</style>
