---
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

import Analytics from "../components/Analytics.astro";
import Footer from "../components/Footer.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import Logo from "../components/Logo.astro";
import type { MessageKey } from "../i18n/es.ts";
import { defaultLocale, locales } from "../i18n/locales.ts";
import { routeLocale, translate } from "../i18n/translate.ts";
import type { Page } from "../lib/analytics/events.ts";
import { localeHome, siteOrigin } from "../lib/crawlers.ts";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/buttons.css";
import "../styles/fields.css";
import "../styles/tiles.css";
import "../styles/notices.css";
import "../styles/surfaces.css";
import "../styles/dialogs.css";

interface Props {
	/** Pages that must stay out of search results: no canonical, no language alternates. */
	readonly noindex?: boolean;
	readonly title?: MessageKey;
	/** Which page analytics reports; it never sees the address itself. */
	readonly page?: Page;
}

const { noindex = false, title = "meta.title", page = "tool" } = Astro.props;
const lang = routeLocale(Astro.currentLocale);
const site = siteOrigin(Astro.site);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#002233" />
		<title>{translate(lang, title)}</title>
		<meta name="description" content={translate(lang, "meta.description")} />
		{
			noindex ? (
				<meta name="robots" content="noindex" />
			) : (
				<>
					<link rel="canonical" href={new URL(Astro.url.pathname, site).href} />
					{locales.map((code) => (
						<link rel="alternate" hreflang={code} href={localeHome(site, code)} />
					))}
					<link rel="alternate" hreflang="x-default" href={localeHome(site, defaultLocale)} />
				</>
			)
		}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-paper-mono" preload />
	</head>
	<body data-page={page}>
		<header>
			<Logo href={getRelativeLocaleUrl(lang)} />
			<LanguageSwitch />
		</header>
		<main>
			<slot />
		</main>
		<Footer />
		<Analytics />
	</body>
</html>

<style>
	body {
		display: grid;
		/* minmax(0, 1fr): an `auto` column grows to its widest content and pushes past the screen. */
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto 1fr auto;
		gap: 24px;
		padding: 28px 32px 50px;
	}

	header {
		display: flex;
		gap: 16px;
		align-items: center;
		justify-content: space-between;
	}

	main {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		place-items: center;
	}
</style>
