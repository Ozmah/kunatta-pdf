---
import { Font } from "astro:assets";

import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import { defaultLocale, locales, type Locale } from "../i18n/locales.ts";
import { translate } from "../i18n/translate.ts";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/controls.css";
import "../styles/rows.css";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#002233" />
		<title>{translate(lang, "meta.title")}</title>
		<meta name="description" content={translate(lang, "meta.description")} />
		{locales.map((code) => <link rel="alternate" hreflang={code} href={`/${code}/`} />)}
		<link rel="alternate" hreflang="x-default" href={`/${defaultLocale}/`} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-paper-mono" preload />
	</head>
	<body>
		<header>
			<Logo href={`/${lang}/`} />
		</header>
		<main>
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style>
	body {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 24px;
		padding: 28px 32px 50px;
	}

	main {
		display: grid;
		place-items: center;
	}
</style>
