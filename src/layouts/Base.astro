---
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

import Footer from "../components/Footer.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import Logo from "../components/Logo.astro";
import { defaultLocale, locales } from "../i18n/locales.ts";
import { routeLocale, translate } from "../i18n/translate.ts";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/buttons.css";
import "../styles/fields.css";
import "../styles/tiles.css";
import "../styles/notices.css";
import "../styles/surfaces.css";
import "../styles/dialogs.css";

const lang = routeLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#002233" />
		<title>{translate(lang, "meta.title")}</title>
		<meta name="description" content={translate(lang, "meta.description")} />
		{locales.map((code) => <link rel="alternate" hreflang={code} href={getRelativeLocaleUrl(code)} />)}
		<link rel="alternate" hreflang="x-default" href={getRelativeLocaleUrl(defaultLocale)} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-paper-mono" preload />
	</head>
	<body>
		<header>
			<Logo href={getRelativeLocaleUrl(lang)} />
			<LanguageSwitch />
		</header>
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		display: grid;
		/* minmax(0, 1fr): an `auto` column grows to its widest content and pushes past the screen. */
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto 1fr auto;
		gap: 24px;
		padding: 28px 32px 50px;
	}

	header {
		display: flex;
		gap: 16px;
		align-items: center;
		justify-content: space-between;
	}

	main {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		place-items: center;
	}
</style>
